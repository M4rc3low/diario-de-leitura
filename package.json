{
  "name": "diario-de-leitura",
  "version": "1.0.0",
  "description": "Diário de leitura com busca de capas, backup, importação, exportação e preparação para Android/iOS.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "mobile:init": "npx cap init DiarioDeLeitura com.marcelo.diariodeleitura --web-dir .",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:sync": "npx cap sync",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/cli": "latest",
    "@capacitor/core": "latest",
    "@capacitor/ios": "latest",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {}
}
